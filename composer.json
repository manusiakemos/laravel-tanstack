{
    "name": "manusiakemos/laravel-tanstack",
    "description": "Modern server-side datatable for Laravel, designed for TanStack Table frontends. Drop-in query builder with searching, sorting, filtering, and pagination.",
    "keywords": [
        "laravel",
        "datatables",
        "tanstack",
        "inertia",
        "server-side",
        "table",
        "eloquent",
        "query-builder"
    ],
    "homepage": "https://github.com/manusiakemos/laravel-tanstack",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Hafiz",
            "email": "hafiz@example.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "laravel/pint": "^1.18",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "Manusiakemos\\LaravelTanstack\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manusiakemos\\LaravelTanstack\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Manusiakemos\\LaravelTanstack\\LaravelTanstackServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
